# ══════════════════════════════════════════════════════════════
# SEMTA Web — Variables de entorno
# Copiar como .env.local para desarrollo local
# En Vercel: Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# URL pública del sitio (sin slash final)
NEXT_PUBLIC_SITE_URL=https://pagina-web-semta.vercel.app

# ── Firebase Web SDK (van al browser, prefijo NEXT_PUBLIC_) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Analytics 4 ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# ── Firebase Admin SDK (SOLO servidor, sin NEXT_PUBLIC_) ─────
# Obtener en: Firebase Console → Project Settings → Cuentas de servicio
# → Generar nueva clave privada → abrir el JSON descargado
FIREBASE_PROJECT_ID=semta-f5c29
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@semta-f5c29.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ── Google Custom Search API (para la sección Noticias Actuales) ──
# Obtener API KEY de GCP: https://console.cloud.google.com/apis/credentials
# Obtener Search Engine ID de: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

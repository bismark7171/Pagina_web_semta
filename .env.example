# Copiar este archivo como .env.local para desarrollo local
# En Vercel configurar estas variables en Settings > Environment Variables

# URL pública del sitio (sin slash final)
# En demo: https://pagina-web-semta.vercel.app
# En producción: https://semta.org.bo
NEXT_PUBLIC_SITE_URL=https://pagina-web-semta.vercel.app

# Firebase (para cuando se conecte Firestore)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
